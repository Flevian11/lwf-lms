    private function module(string $title, string $description, array $lessons, array $materials): array
    {
        return compact('title', 'description', 'lessons', 'materials');
    }

    private function lesson(string $title, string $type, int $duration, string $content, bool $preview): array
    {
        return compact('title', 'type', 'duration', 'content', 'preview');
    }

    private function pdf(string $title, string $description, bool $preview): array
    {
        return [
            'title' => $title,
            'type' => 'pdf',
            'description' => $description,
            'preview' => $preview,
        ];
    }

    private function link(string $title, string $url, string $description, bool $preview): array
    {
        return [
            'title' => $title,
            'type' => 'link',
            'url' => $url,
            'description' => $description,
            'preview' => $preview,
        ];
    }

    private function seedCourseContent(int $courseId, array $modules, $now): void
    {
        foreach ($modules as $modulePosition => $moduleData) {
            $moduleId = DB::table('course_modules')->insertGetId([
                'course_id' => $courseId,
                'title' => $moduleData['title'],
                'description' => $moduleData['description'],
                'position' => $modulePosition + 1,
                'is_preview' => $modulePosition === 0,
                'created_at' => $now,
                'updated_at' => $now,
            ]);

            $lessonIds = [];

            foreach ($moduleData['lessons'] as $lessonPosition => $lesson) {
                $lessonId = DB::table('lessons')->insertGetId([
                    'module_id' => $moduleId,
                    'title' => $lesson['title'],
                    'slug' => Str::slug($lesson['title']),
                    'description' => Str::limit(strip_tags($lesson['content']), 450),
                    'content' => $lesson['content'],
                    'type' => $lesson['type'],
                    'position' => $lessonPosition + 1,
                    'is_preview' => $lesson['preview'],
                    'duration_minutes' => $lesson['duration'],
                    'status' => 'published',
                    'published_at' => $now,
                    'created_at' => $now,
                    'updated_at' => $now,
                ]);

                $lessonIds[] = $lessonId;
            }

            foreach ($moduleData['materials'] as $materialPosition => $material) {
                $filePath = null;
                $mimeType = null;

                if ($material['type'] === 'pdf') {
                    $fileName = Str::slug($material['title']) . '.pdf';
                    $directory = storage_path('app/public/course-materials');

                    File::ensureDirectoryExists($directory);

                    $filePath = "course-materials/{$fileName}";

                    File::put(
                        storage_path("app/public/{$filePath}"),
                        $this->makePdf($material['title'], $material['description']),
                    );

                    $mimeType = 'application/pdf';
                }

                $lessonId = $lessonIds[$materialPosition % max(count($lessonIds), 1)] ?? null;

                DB::table('course_materials')->insert([
                    'course_id' => $courseId,
                    'module_id' => $moduleId,
                    'lesson_id' => $lessonId,
                    'title' => $material['title'],
                    'description' => $material['description'],
                    'type' => $material['type'],
                    'url' => $material['url'] ?? null,
                    'file_path' => $filePath,
                    'mime_type' => $mimeType,
                    'is_preview' => $material['preview'],
                    'position' => $materialPosition + 1,
                    'status' => 'published',
                    'metadata' => $material['type'] === 'video'
                        ? json_encode(['provider' => 'youtube'])
                        : null,
                    'created_at' => $now,
                    'updated_at' => $now,
                ]);
            }
        }
    }

    private function makePdf(string $title, string $description): string
    {
        $lines = [
            $title,
            '',
            $description,
            '',
            'Learn With Flevian LMS',
            'Demo learning material',
            '',
            'This PDF is a generated test resource for the LMS materials viewer.',
        ];

        $escape = static function (string $value): string {
            return str_replace(
                ['\\', '(', ')'],
                ['\\\\', '\\(', '\\)'],
                $value,
            );
        };

        $stream = "BT\n/F1 16 Tf\n72 720 Td\n";

        foreach ($lines as $index => $line) {
            if ($index > 0) {
                $stream .= "0 -24 Td\n";
            }

            $stream .= '(' . $escape($line) . ") Tj\n";
        }

        $stream .= "ET\n";

        $objects = [
            '<< /Type /Catalog /Pages 2 0 R >>',
            '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
            '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>',
            '<< /Length ' . strlen($stream) . " >>\nstream\n" . $stream . "endstream",
            '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
        ];

        $pdf = "%PDF-1.4\n";
        $offsets = [0];

        foreach ($objects as $number => $object) {
            $objectNumber = $number + 1;
            $offsets[$objectNumber] = strlen($pdf);
            $pdf .= "{$objectNumber} 0 obj\n{$object}\nendobj\n";
        }

        $xrefOffset = strlen($pdf);
        $pdf .= "xref\n0 " . (count($objects) + 1) . "\n";
        $pdf .= "0000000000 65535 f \n";

        for ($i = 1; $i <= count($objects); $i++) {
            $pdf .= sprintf("%010d 00000 n \n", $offsets[$i]);
        }

        $pdf .= "trailer\n<< /Size " . (count($objects) + 1) . " /Root 1 0 R >>\n";
        $pdf .= "startxref\n{$xrefOffset}\n%%EOF";

        return $pdf;
    }
}
