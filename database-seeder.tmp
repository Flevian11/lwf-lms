<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Str;

class DemoCourseSeeder extends Seeder
{
    public function run(): void
    {
        DB::transaction(function (): void {
            $now = now();

            $student = DB::table('users')
                ->where('email', 'wanjohiramp@gmail.com')
                ->first();

            if (! $student) {
                $student = DB::table('users')
                    ->whereRaw('LOWER(name) = ?', ['ramp wanjohi'])
                    ->first();
            }

            if (! $student) {
                throw new \RuntimeException(
                    'Ramp Wanjohi could not be found. Seeder stopped without creating demo enrollments.'
                );
            }

            $creator = DB::table('users')
                ->where('id', '!=', $student->id)
                ->first();

            $creatorId = $creator?->id ?? $student->id;

            $slugs = [
                'web-development-fundamentals',
                'modern-javascript-for-beginners',
                'laravel-php-professional-development',
                'react-typescript-frontend-engineering',
                'git-github-for-developers',
                'sql-database-design',
                'python-programming-foundations',
                'ui-ux-for-web-developers',
                'rest-apis-backend-integration',
                'career-ready-software-engineering',
            ];

            $existingCourses = DB::table('courses')
                ->whereIn('slug', $slugs)
                ->pluck('id');

            if ($existingCourses->isNotEmpty()) {
                DB::table('course_materials')
                    ->whereIn('course_id', $existingCourses)
                    ->delete();

                $moduleIds = DB::table('course_modules')
                    ->whereIn('course_id', $existingCourses)
                    ->pluck('id');

                $lessonIds = $moduleIds->isNotEmpty()
                    ? DB::table('lessons')
                        ->whereIn('module_id', $moduleIds)
                        ->pluck('id')
                    : collect();

                if ($lessonIds->isNotEmpty()) {
                    DB::table('lesson_progress')
                        ->where('user_id', $student->id)
                        ->whereIn('lesson_id', $lessonIds)
                        ->delete();
                }

                if ($moduleIds->isNotEmpty()) {
                    DB::table('lessons')
                        ->whereIn('module_id', $moduleIds)
                        ->delete();
                }

                DB::table('course_modules')
                    ->whereIn('course_id', $existingCourses)
                    ->delete();

                DB::table('course_learning_interest')
                    ->whereIn('course_id', $existingCourses)
                    ->delete();

                DB::table('course_enrollments')
                    ->whereIn('course_id', $existingCourses)
                    ->delete();

                DB::table('courses')
                    ->whereIn('id', $existingCourses)
                    ->delete();
            }

            $categories = [
                ['name' => 'Web Development', 'slug' => 'web-development', 'description' => 'Web development and frontend fundamentals.'],
                ['name' => 'Programming', 'slug' => 'programming', 'description' => 'Programming languages and software development.'],
                ['name' => 'Backend Development', 'slug' => 'backend-development', 'description' => 'Backend engineering, PHP, Laravel and APIs.'],
                ['name' => 'Version Control', 'slug' => 'version-control', 'description' => 'Git, GitHub and collaborative software development workflows.'],
                ['name' => 'Data & Databases', 'slug' => 'data-databases', 'description' => 'SQL, relational databases and data modelling.'],
                ['name' => 'UI/UX Design', 'slug' => 'ui-ux-design', 'description' => 'User interface and user experience principles for digital products.'],
                ['name' => 'Career Development', 'slug' => 'career-development', 'description' => 'Professional skills for software engineering careers.'],
            ];

            $categoryIds = [];

            foreach ($categories as $category) {
                DB::table('course_categories')->updateOrInsert(
                    ['slug' => $category['slug']],
                    [
                        'name' => $category['name'],
                        'description' => $category['description'],
                        'is_active' => true,
                        'updated_at' => $now,
                        'created_at' => $now,
                    ],
                );

                $categoryIds[$category['slug']] = DB::table('course_categories')
                    ->where('slug', $category['slug'])
                    ->value('id');
            }

            $courses = $this->courses();

            foreach ($courses as $courseData) {
                $courseId = DB::table('courses')->insertGetId([
                    'category_id' => $categoryIds[$courseData['category']],
                    'created_by' => $creatorId,
                    'title' => $courseData['title'],
                    'slug' => $courseData['slug'],
                    'short_description' => $courseData['short_description'],
                    'description' => $courseData['description'],
                    'thumbnail_path' => null,
                    'level' => $courseData['level'],
                    'status' => 'published',
                    'access_type' => $courseData['access_type'],
                    'price' => $courseData['price'],
                    'currency' => 'KES',
                    'published_at' => $now,
                    'created_at' => $now,
                    'updated_at' => $now,
                ]);

                $this->seedCourseContent($courseId, $courseData['modules'], $now);

                $interestId = DB::table('learning_interests')
                    ->where('name', $courseData['interest'])
                    ->value('id');

                if ($interestId) {
                    DB::table('course_learning_interest')->insertOrIgnore([
                        'course_id' => $courseId,
                        'learning_interest_id' => $interestId,
                    ]);
                }

                if ($courseData['free_for_demo_student']) {
                    DB::table('course_enrollments')->insert([
                        'user_id' => $student->id,
                        'course_id' => $courseId,
                        'source' => 'free',
                        'payment_id' => null,
                        'approved_by' => null,
                        'approved_at' => null,
                        'access_granted_at' => $now,
                        'status' => 'active',
                        'enrolled_at' => $now,
                        'started_at' => null,
                        'completed_at' => null,
                        'created_at' => $now,
                        'updated_at' => $now,
                    ]);
                }
            }
        });

        $this->command?->info('Demo course catalogue created successfully: 10 courses, expanded topics, lessons and materials.');
        $this->command?->info('Ramp Wanjohi was enrolled in the free demo courses.');
    }

